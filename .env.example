# Environment Variables Example
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o arquivo .env com valores reais!

# ============================================
# Supabase Configuration
# ============================================
# Descomente e configure quando adicionar Supabase ao projeto
# Obtenha esses valores no dashboard do Supabase: Settings > API

# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# ============================================
# Supabase MCP Server Configuration
# ============================================
# Essas variáveis são usadas pelo script setup:mcp para configurar
# o MCP Server do Supabase no Claude Code
# IMPORTANTE: A SERVICE_ROLE_KEY é sensível - NUNCA commite o .env!

# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua-chave-anonima-aqui
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ============================================
# Outras variáveis de ambiente
# ============================================
# Adicione outras variáveis conforme necessário
# Lembre-se: variáveis devem começar com VITE_ para serem acessíveis no browser

# VITE_API_URL=http://localhost:3000
# VITE_ANALYTICS_ID=seu-analytics-id
